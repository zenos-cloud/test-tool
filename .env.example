# ===== OKX =====
# Tạo API key tại: OKX > Hồ sơ > API. CHỈ bật quyền "Đọc" + "Giao dịch". KHÔNG bật "Rút tiền".
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 1 = tài khoản DEMO (tiền ảo, an toàn để thử). 0 = tiền thật.
OKX_DEMO=1

# ===== Telegram (để dùng trên điện thoại) =====
# Tạo bot bằng @BotFather, lấy token. Chat ID lấy bằng lệnh /myid sau khi chạy bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Lịch hằng ngày (giờ Việt Nam) =====
TIMEZONE_OFFSET=7
DAILY_REPORT_TIME=08:00
REMINDER_TIME=20:00

# ===== Mua định kỳ (DCA) - MẶC ĐỊNH TẮT =====
DCA_ENABLED=0
DCA_PAIR=BTC-USDT
# Số USDT mua mỗi ngày
DCA_AMOUNT_USDT=5
DCA_TIME=09:00
# Giới hạn an toàn: tool từ chối mọi lệnh lớn hơn số này
MAX_ORDER_USDT=20
